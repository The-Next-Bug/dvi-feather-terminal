# Pinned build toolchain. Single source of truth for scripts/setup-toolchain.sh;
# CI's build image (images/build-image Dockerfile ARGs) must match it, or each
# CI job downloads the toolchain. Plain KEY=value lines only.
#
# pico-sdk is pinned as a git submodule under lib/, not here.
CMAKE_VERSION=3.31.12
CMAKE_SHA256=0dc2e9a6860f06bf10bd8fadc03e35d9eeb4df46e33763a7e480e987758f385c
ARM_GNU_VERSION=14.3.rel1
ARM_GNU_SHA256=8f6903f8ceb084d9227b9ef991490413014d991874a1e34074443c2a72b14dbd
PICOTOOL_VERSION=2.3.1
PICOTOOL_COMMIT=2041936441b48a3cc53ae3da9e805229fe8f4e18
# clang-tidy for scripts/lint.sh, from PyPI's static build (manylinux2014).
CLANG_TIDY_VERSION=21.1.1
CLANG_TIDY_SHA256=c1e31eed946b8fc6730a426ca818cb9de5ecb6344223cafe6a4da7b05fd3bb32
# mdBook for scripts/docs.sh (the user guide), the static musl build.
MDBOOK_VERSION=0.5.4
MDBOOK_SHA256=5222beabd3e37dc5be0d18ff99b79058469354db5c220153a1b92db5ba12be89
