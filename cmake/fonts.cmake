# Font tables generated by src/font_gen.py. Include with GENERATED set to
# the output directory; sets FONT_SOURCES and FONT_DEFINITIONS (compile
# definitions for every target that includes raster.h). Shared by the
# firmware and the host tests.

find_package(Python3 REQUIRED COMPONENTS Interpreter)

set(FONT_GEN "${CMAKE_CURRENT_LIST_DIR}/../src/font_gen.py")
set(FONT_DIR "${CMAKE_CURRENT_LIST_DIR}/../assets/fonts")

# The 132-column font. 6x12 and 6x10 show each glyph row on two scanlines:
# 6x12 fills the 24-scanline rows (rounder letters; accented capitals can
# meet the descenders of the row above), 6x10 leaves 2 blank scanlines
# above and below. 6x13 is shown as is (13 blank scanlines between lines).
set(FONT_132_VARIANTS 6x12 6x10 6x13)
set(FONT_132 "6x12" CACHE STRING "132-column font: 6x12 or 6x10 (double height), or 6x13")
set_property(CACHE FONT_132 PROPERTY STRINGS ${FONT_132_VARIANTS})

# font_table(<name> <out.c> <source> <width> <height> [FLASH]): generate the
# table <name> into <out.c>; FLASH keeps it in the firmware's flash
# (FONT_FLASH_DATA in src/font.h), read by core 0 only.
function(font_table name out source width height)
  set(flash "")
  if("FLASH" IN_LIST ARGN)
    set(flash "--flash")
  endif()
  add_custom_command(
    OUTPUT ${out}
    COMMAND ${CMAKE_COMMAND} -E make_directory ${GENERATED}
    COMMAND Python3::Interpreter ${FONT_GEN} ${flash}
            ${FONT_DIR}/${source} ${width} ${height} ${name} ${out}
    DEPENDS ${FONT_GEN} ${FONT_DIR}/${source}
    COMMENT "Generating ${name} (${source})"
    VERBATIM)
endfunction()

# font_132(<variant> <sources var> <definitions var>): the font_132 table for
# a FONT_132 variant, and the definitions that describe it to the renderer.
function(font_132 variant sources_var defs_var)
  if(variant STREQUAL "6x12")
    set(height 12)
    set(scale 2)
  elseif(variant STREQUAL "6x10")
    set(height 10)
    set(scale 2)
  elseif(variant STREQUAL "6x13")
    set(height 13)
    set(scale 1)
  else()
    string(REPLACE ";" ", " names "${FONT_132_VARIANTS}")
    message(FATAL_ERROR "FONT_132 must be one of ${names}, not '${variant}'")
  endif()
  set(out "${GENERATED}/font_132_${variant}.c")
  font_table(font_132 ${out} misc-fixed-${variant}.bdf 6 ${height})
  set(${sources_var} ${out} PARENT_SCOPE)
  set(${defs_var} FONT_132_HEIGHT=${height} FONT_132_SCALE=${scale} PARENT_SCOPE)
endfunction()

font_table(font_8x16 "${GENERATED}/font_8x16.c" Uni2-Terminus16.psf.gz 8 16)
# Bold text in 80 columns: Terminus's own bold face (in flash: SRAM is short).
font_table(font_8x16_bold "${GENERATED}/font_8x16_bold.c" Uni2-TerminusBold16.psf.gz 8 16 FLASH)
# 80 columns at full width (10-pixel cells), with its bold face; in flash.
font_table(font_10x20 "${GENERATED}/font_10x20.c" Uni2-Terminus20x10.psf.gz 10 20 FLASH)
font_table(font_10x20_bold "${GENERATED}/font_10x20_bold.c" Uni2-TerminusBold20x10.psf.gz 10 20 FLASH)
font_132(${FONT_132} FONT_132_SOURCE FONT_DEFINITIONS)
# Every font but the 132-column one (which FONT_132 picks).
set(FONT_COMMON_SOURCES "${GENERATED}/font_8x16.c" "${GENERATED}/font_8x16_bold.c" "${GENERATED}/font_10x20.c"
  "${GENERATED}/font_10x20_bold.c")
set(FONT_SOURCES ${FONT_COMMON_SOURCES} ${FONT_132_SOURCE})
