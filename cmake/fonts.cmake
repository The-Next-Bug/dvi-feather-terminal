# Font tables generated by src/font_gen.py. Include with GENERATED set to
# the output directory; sets FONT_SOURCES. Shared by the firmware and the
# host tests.

find_package(Python3 REQUIRED COMPONENTS Interpreter)

set(FONT_GEN "${CMAKE_CURRENT_LIST_DIR}/../src/font_gen.py")
set(FONT_DIR "${CMAKE_CURRENT_LIST_DIR}/../assets/fonts")
set(FONT_SOURCES)

# font_table(<name> <source> <width> <height> [extra font_gen.py args...])
function(font_table name source width height)
  set(out "${GENERATED}/${name}.c")
  add_custom_command(
    OUTPUT ${out}
    COMMAND ${CMAKE_COMMAND} -E make_directory ${GENERATED}
    COMMAND Python3::Interpreter ${FONT_GEN} ${ARGN}
            ${FONT_DIR}/${source} ${width} ${height} ${name} ${out}
    DEPENDS ${FONT_GEN} ${FONT_DIR}/${source}
    COMMENT "Generating ${name}"
    VERBATIM)
  set(FONT_SOURCES ${FONT_SOURCES} ${out} PARENT_SCOPE)
endfunction()

font_table(font_8x16 Uni2-Terminus16.psf.gz 8 16)
font_table(font_6x13 misc-fixed-6x13.bdf 6 13)
