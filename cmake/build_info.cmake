# Write term_build.h (build id, commit, date) from git. Run in script mode on
# every build:
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<file> -P build_info.cmake
# The file is rewritten only when its contents change, so an unchanged
# revision does not force a relink.

function(git_output var)
  execute_process(COMMAND git ${ARGN}
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE out OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0 AND out)
    set(${var} "${out}" PARENT_SCOPE)
  else()
    set(${var} "unknown" PARENT_SCOPE)
  endif()
endfunction()

git_output(build_id describe --always --dirty)
git_output(commit rev-parse --short HEAD)
string(TIMESTAMP date "%Y-%m-%d" UTC)
# Keep the title bar ("DVI Feather Terminal  build <id>  <sha>  <date>") in 80
# columns.
string(SUBSTRING "${build_id}" 0 28 build_id)

set(content "// Generated by cmake/build_info.cmake -- do not edit.
#define TERM_BUILD_ID     \"${build_id}\"
#define TERM_BUILD_COMMIT \"${commit}\"
#define TERM_BUILD_DATE   \"${date}\"
")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT content STREQUAL old)
  file(WRITE "${OUTPUT}" "${content}")
endif()
