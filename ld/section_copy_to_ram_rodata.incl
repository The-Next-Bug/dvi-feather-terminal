/* Replaces pico-sdk's section_copy_to_ram_rodata.incl (bd qur.24).

   In a copy_to_ram binary everything runs from SRAM and only .flashdata*
   stays in flash. Cold code (and its constants) runs from flash through
   XIP here instead, to save SRAM: code core 0 needs only now and then
   (panels, the monitor, FatFs, the USB host's enumeration). printf stays
   in SRAM: panic() uses it, also during the firmware update's commit.
   This section comes before .text and .data, so these objects' code and
   constants land here and not in SRAM.

   Our code is in static libraries (src/<name> -> libdvt_<name>.a, bd gr1):
   *libdvt_<name>.a:<file>.c.o picks one object, *libdvt_<name>.a:* the
   whole library. A pattern that matches nothing leaves its code in SRAM
   without a word from the linker: scripts/check_sram_only.py fails the
   build then.

   Code in flash may run only after nvflash_retime() and never on core 1,
   during a flash erase/program or in the firmware update's commit:
   scripts/check_sram_only.py checks that from the disassembly. */

SECTIONS
{
    .rodata : {
        *(SORT_BY_ALIGNMENT(SORT_BY_NAME(.flashdata*)))
        . = ALIGN(4);
        __cold_text_start__ = .;
        *libfatfs.a:ff.c.o(.text* .rodata*)
        *tinyusb/src/host/usbh.c.o(.text* .rodata*)
        *tinyusb/src/host/hub.c.o(.text* .rodata*)
        *tinyusb/src/class/hid/hid_host.c.o(.text* .rodata*)
        *tinyusb/src/class/msc/msc_host.c.o(.text* .rodata*)
        *libdvt_ui.a:*(.text* .rodata*)
        *libdvt_disks.a:drivecfg.c.o(.text* .rodata*)
        *libdvt_screen.a:palette.c.o(.text* .rodata*)
        *libdvt_disks.a:xfer.c.o(.text* .rodata*)
        *libdvt_storage.a:usbmsc.c.o(.text* .rodata*)
        *libdvt_common.a:lz.c.o(.text* .rodata*)
        *libdvt_disks.a:diskimg.c.o(.text* .rodata*)
        *libdvt_disks.a:sdformat.c.o(.text* .rodata*)
        *libdvt_input.a:keyname.c.o(.text* .rodata*)
        *libdvt_settings.a:settings.c.o(.text* .rodata*)
        *libdvt_settings.a:uf2.c.o(.text* .rodata*)
        *libdvt_machine.a:machine.c.o(.rodata*)
        *dvi_terminal.dir/hwinfo_glue.c.o(.text* .rodata*)
        *dvi_terminal.dir/usblog_glue.c.o(.text* .rodata*)
        *libg.a:libc_a-qsort.o(.text* .rodata*)
        . = ALIGN(4);
        __cold_text_end__ = .;
    } > TEXT_STORE
}
