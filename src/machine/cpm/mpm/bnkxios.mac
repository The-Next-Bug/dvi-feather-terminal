;
;	MP/M 2 XIOS for z80pack machines using SD-FDC
;
;	Copyright (C) 1989-2024 by Udo Munk
;	Copyright (C) 2025 by Thomas Eberhardt
;	(z80pack, MIT license)
;
;	The dvi-feather-terminal's version (bd l1j.2): eight drives A-H,
;	each of the formats the disk controller's port 8 reports for the
;	image mounted on it (8" floppy, 4 MB or 8 MB hard disk), as our
;	CP/M 2.2 and CP/M 3 BIOSes do. Assembled with M80, linked into
;	BNKXIOS.SPR and made into MPM.SYS by GENSYS at build time
;	(build.sh).
;
;	The XIOS has two parts. Before COMMONBASE is the banked part,
;	which only the banked BDOS calls, in bank 0: selecting a drive,
;	its DPH, the sector translation and the allocation and checksum
;	vectors (2 KB for eight hard disks). From COMMONBASE on is the
;	common part, above the common base (C000H), reachable from every
;	bank: the console, memory and clock entries, the interrupt
;	handler, the disk I/O itself (the controller reads its command
;	block and moves the data while the user's bank is selected) and
;	what the controller reads or writes there: the command block and
;	the directory buffer. The DPBs are common too: BDOS function 31
;	hands programs (STAT) their address.
;
;	When another image is mounted later (SET-UP's Drives panel), READ
;	and WRITE see port 8's format or mount count differ from the
;	log-in's. MP/M II's BDOS has no media change return (CP/M 3's
;	0FFH is a bad sector to it) and logs a drive in again only when
;	told to (DSKRESET, BDOS function 37), so until then READ and WRITE
;	fail (Bdos Err ... Bad Sector): nothing is read by the old image's
;	layout, nothing written by its allocation. The log-in (SELDSK)
;	then puts in the new image's DPB.
;
; History:
; 12-MAR-2025 first public release based on cpmsim/srcmpm and RP2xxx/srccpm3
; 30-OCT-2026 drives A-H, formats from port 8, console 1 output status
;	      (dvi-feather-terminal)
;
NMBCNS	EQU	2		;number of consoles
TICKPS	EQU	60		;number of ticks per second
NDRV	EQU	8		;drives A-H
;
;	i/o ports
;
CON0STA	EQU	0		;console 0 status port
CON0DAT	EQU	1		;console 0 data port
CON1STA	EQU	2		;console 1 status port
CON1DAT	EQU	3		;console 1 data port
PRTSTA	EQU	5		;printer status port
PRTDAT	EQU	6		;printer data port
FDC	EQU	4		;FDC
DINFO	EQU	8		;drive format: OUT drive, IN 0 none, 1 8" floppy,
				;2 4 MB, 3 8 MB hard disk, IN again the
				;mount count (ours)
MMUSEL	EQU	64		;bank select mmu
CLKCMD	EQU	65		;clock command
CLKDAT	EQU	66		;clock data
TIMER	EQU	67		;interrupt timer
LEDS	EQU	255		;frontpanel led's
;
;	clock commands
;
GETSEC	EQU	0		;get seconds
;
;	XDOS functions
;
POLL	EQU	131		;xdos poll function
PLCO0	EQU	0		;poll console out #0
PLCI0	EQU	1		;poll console in #0
PLCO1	EQU	2		;poll console out #1
PLCI1	EQU	3		;poll console in #1
FLAGSET	EQU	133		;xdos flag set function
;
	.Z80
	CSEG
;
;	jump vector for individual subroutines
;
	JP	COMMONBASE	;commonbase
	JP	WARMSTART	;warm start
	JP	CONST		;console status
	JP	CONIN		;console character in
	JP	CONOUT		;console character out
	JP	LIST		;list character out
	JP	PUNCH		;not used by MP/M 2
	JP	READER		;not used by MP/M 2
	JP	HOME		;move head to home
	JP	SELDSK		;select disk
	JP	SETTRK		;set track numer
	JP	SETSEC		;set sector number
	JP	SETDMA		;set dma address
	JP	READ		;read disk
	JP	WRITE		;write disk
	JP	LISTST		;not used by MP/M 2
	JP	SECTRAN		;sector translate
	JP	SELMEMORY	;select memory
	JP	POLLDEVICE	;poll device
	JP	STARTCLOCK	;start clock
	JP	STOPCLOCK	;stop clock
	JP	EXITREGION	;exit region
	JP	MAXCONSOLE	;maximum console number
	JP	SYSTEMINIT	;system initialization
	JP	IDLE		;idle prozedure
;
;	---- the banked part: bank 0 only ----
;
;	move to the track 00 position of current drive
;	translate this call into a settrk call with parameter 00
;
HOME:	LD	C,0		;select track 0
	JP	SETTRK		;we will move to 00 on first read/write
;
;	select disk given by register C (0-7); bit 0 of E is 0 on its
;	first select since the drive was reset (log-in). Port 8 gives the
;	format of the image mounted on it: none (or unknown) is a select
;	error. On a log-in (or the first select: FMTS 0) the DPH gets the
;	format's translate table and DPB, and READ and WRITE work again on
;	a drive they found another image on (CHGS).
;
SELDSK:	LD	HL,0		;error return code
	LD	A,C
	CP	NDRV		;one of ours?
	RET	NC		;no, error
	OUT	(DINFO),A	;ask the controller for its format
	IN	A,(DINFO)
	OR	A		;no disk?
	RET	Z		;error
	CP	4		;known format?
	RET	NC		;no, error
	LD	D,A		;D = format 1-3
	LD	A,C
	LD	(SDISK),A
	LD	B,0
	LD	HL,FMTS
	ADD	HL,BC
	BIT	0,E		;log-in?
	JR	Z,SELLOG	;yes
	LD	A,(HL)		;logged in with an image still there?
	OR	A
	JR	NZ,DPHOF	;yes: HL = the DPH as it is
SELLOG:	LD	(HL),D		;FMTS(disk) = the format logged in
	LD	HL,CHGS		;CHGS(disk) = 0: the same image as the BDOS's
	ADD	HL,BC
	LD	(HL),0
	LD	HL,MNTS		;MNTS(disk) = its mount count
	ADD	HL,BC
	IN	A,(DINFO)
	LD	(HL),A
	CALL	DPHOF		;HL = the DPH
	PUSH	HL		;returned
	LD	BC,TRANS	;floppies are skewed
	LD	A,D
	CP	1
	JR	Z,SEL1
	LD	BC,0		;hard disks are not
SEL1:	LD	(HL),C		;translate table
	INC	HL
	LD	(HL),B
	LD	BC,9		;.DPH+10 = DPB
	ADD	HL,BC
	LD	A,D		;BC = DPBTAB(format - 1)
	DEC	A
	ADD	A,A
	LD	C,A
	LD	B,0
	PUSH	HL
	LD	HL,DPBTAB
	ADD	HL,BC
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	POP	HL
	LD	(HL),C		;DPB
	INC	HL
	LD	(HL),B
	POP	HL
	RET
;
;	HL = the DPH of drive SDISK (uses BC)
;
DPHOF:	LD	A,(SDISK)
	LD	L,A
	LD	H,0
	ADD	HL,HL		;*2
	ADD	HL,HL		;*4
	ADD	HL,HL		;*8
	ADD	HL,HL		;*16 (size of each header)
	LD	BC,DPBASE
	ADD	HL,BC
	RET
;
;	set track given by register c
;
SETTRK: LD	A,C
	LD	(DDTRK),A
	RET
;
;	set sector given by register bc
;
SETSEC: LD	A,C
	LD	(DDSEC),A
	RET
;
;	translate the sector given by BC using the
;	translate table given by DE
;
SECTRAN:
	LD	A,D		;do we have a translation table?
	OR	E
	JR	NZ,SECT1	;yes, translate
	LD	L,C		;no, return untranslated
	LD	H,B		;in HL
	INC	HL		;sector no. start with 1
	RET
SECT1:	EX	DE,HL		;HL=.trans
	ADD	HL,BC		;HL=.trans(sector)
	LD	L,(HL)		;L = trans(sector)
	LD	H,0		;HL= trans(sector)
	RET			;with value in HL
;
;	set dma address given by registers b and c
;
SETDMA: LD	A,C		;low order address
	LD	(DDLDMA),A	;set in FDC command bytes
	LD	A,B		;high order address
	LD	(DDHDMA),A	;set in FDC command bytes
	RET
;
;	perform read operation
;
READ:	CALL	CHKFMT		;another image mounted?
	LD	A,1		;yes: an error, until the BDOS logs it in
	RET	NZ
	LD	A,(SDISK)	;get disk
	OR	20H		;mask in read command
	JP	WAITIO		;to perform the actual i/o
;
;	perform a write operation
;
WRITE:	CALL	CHKFMT		;another image mounted?
	LD	A,1		;yes: an error, until the BDOS logs it in
	RET	NZ
	LD	A,(SDISK)	;get disk
	OR	40H		;mask in write command
	JP	WAITIO
;
;	Z if the selected drive still has the image it was logged in with
;	(port 8: the same format and mount count), else NZ, until the
;	BDOS logs it in again (CHGS).
;
CHKFMT:	LD	A,(SDISK)
	LD	C,A
	LD	B,0
	LD	HL,CHGS		;seen another image already?
	ADD	HL,BC
	LD	A,(HL)
	OR	A
	RET	NZ		;yes
	LD	A,C
	OUT	(DINFO),A
	LD	HL,FMTS
	ADD	HL,BC
	IN	A,(DINFO)	;the format
	CP	(HL)
	JR	NZ,CHKF1
	LD	HL,MNTS
	ADD	HL,BC
	IN	A,(DINFO)	;the mount count
	CP	(HL)
	RET	Z
CHKF1:	LD	HL,CHGS		;CHGS(disk) = 1 until the log-in
	ADD	HL,BC
	LD	(HL),1
	OR	0FFH		;NZ
	RET
;
SIGNON:	DEFB	13,10
	DEFM	'MP/M 2 XIOS V1.9, '
	DEFM	'Copyright 1989-2024 by Udo Munk'
	DEFM	' & 2025 by Thomas Eberhardt'
	DEFB	13,10
	DEFM	'dvi-feather-terminal: drives A-H, 8" floppy, 4 MB and 8 MB'
	DEFM	' hard disks'
	DEFB	13,10,0
;
SDISK:	DEFB	0		;selected disk
FMTS:	DEFB	0,0,0,0,0,0,0,0	;the format each drive was logged in with
MNTS:	DEFB	0,0,0,0,0,0,0,0	;and the mount count (port 8) then
CHGS:	DEFB	0,0,0,0,0,0,0,0	;1: another image since, not logged in yet
;
;	disk parameter headers: XLT and DPB are set by SELDSK. The vectors
;	are as large as any format needs: 2040 blocks of the hard disks,
;	the floppy's 16 checksums (hard disks have none).
;
ALVSIZ	EQU	256
CSVSIZ	EQU	16
DPBASE:	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+0*CSVSIZ,ALVS+0*ALVSIZ
	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+1*CSVSIZ,ALVS+1*ALVSIZ
	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+2*CSVSIZ,ALVS+2*ALVSIZ
	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+3*CSVSIZ,ALVS+3*ALVSIZ
	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+4*CSVSIZ,ALVS+4*ALVSIZ
	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+5*CSVSIZ,ALVS+5*ALVSIZ
	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+6*CSVSIZ,ALVS+6*ALVSIZ
	DEFW	TRANS,0000H,0000H,0000H,DIRBF,DPBFD,CSVS+7*CSVSIZ,ALVS+7*ALVSIZ
;
;	sector translate vector for the IBM 8" SD disks
;
TRANS:	DEFB	1,7,13,19	;sectors 1,2,3,4
	DEFB	25,5,11,17	;sectors 5,6,7,8
	DEFB	23,3,9,15	;sectors 9,10,11,12
	DEFB	21,2,8,14	;sectors 13,14,15,16
	DEFB	20,26,6,12	;sectors 17,18,19,20
	DEFB	18,24,4,10	;sectors 21,22,23,24
	DEFB	16,22		;sectors 25,26
;
DPBTAB:	DEFW	DPBFD,DPBHD4,DPBHD8
;
ALVS:	DEFS	NDRV*ALVSIZ	;allocation vectors
CSVS:	DEFS	NDRV*CSVSIZ	;check vectors
;
;	---- the common part ----
;
COMMONBASE:
	JP	COLDSTART
SWTUSER:
	JP	$-$
SWTSYS:	JP	$-$
PDISP:	JP	$-$
XDOS:	JP	$-$
SYSDAT:	DEFW	$-$
;
COLDSTART:
WARMSTART:
	LD	C,0
	JP	XDOS		;system reset, terminate prozess
;
;	MP/M II V2.0 Console Bios
;
CONST:
	CALL	PTBLJMP		;compute and jump to handler
	DW	PTSTI0
	DW	PTSTI1
;
CONIN:
	CALL	PTBLJMP		;compute and jump to handle
	DW	PTIN0
	DW	PTIN1
;
CONOUT:
	CALL	PTBLJMP		;compute and jump to handler
	DW	PTOUT0
	DW	PTOUT1
;
PTBLJMP:			;compute and jump to handler
	LD	A,D
	ADD	A,A		;double table index for address offset
	POP	HL		;return address of jump table
	LD	E,A
	LD	D,0
	ADD	HL,DE		;table index * 2 + table base
	LD	E,(HL)		;get handler address
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	JP	(HL)		;jump to computed handler
;
PTSTI0:	IN	A,(CON0STA)	;console 0 input status
	AND	01H		;input ready?
	JP	NZ,DEVNRY	;if device not ready
;	return with device ready
DEVRDY:	LD	A,0FFH
	RET
;
PTSTO0:	IN	A,(CON0STA)	;console 0 output status
	AND	80H		;output ready?
	JP	Z,DEVRDY	;if device ready
;	return with device not ready
DEVNRY:	XOR	A
	RET
;
PTIN0:	LD	C,POLL		;poll console 0 status in
	LD	E,PLCI0
	CALL	XDOS		;poll console 0
	IN	A,(CON0DAT)	;read character
	RET
;
PTOUT0:	IN	A,(CON0STA)	;console 0 output status
	AND	80H		;ready?
	JP	Z,TXRDY0	;yes, output
	PUSH	BC
	LD	C,POLL		;poll console 0 status out
	LD	E,PLCO0
	CALL	XDOS
	POP	BC
TXRDY0:	LD	A,C		;console 0 output
	OUT	(CON0DAT),A
	RET
;
PTSTI1:	IN	A,(CON1STA)	;console 1 input status
	AND	01H		;input ready?
	JP	NZ,DEVNRY
	JP	DEVRDY
;
PTSTO1:	IN	A,(CON1STA)	;console 1 output status
	AND	80H		;output ready?
	JP	NZ,DEVNRY
	JP	DEVRDY
;
PTIN1:	LD	C,POLL		;poll console 1 status in
	LD	E,PLCI1
	CALL	XDOS		;poll console 1
	IN	A,(CON1DAT)	;read character
	RET
;
;	the same output status bit as console 0's (picosim tested bit 1,
;	which is never set, so every character waited for a poll)
PTOUT1:	IN	A,(CON1STA)	;console 1 output status
	AND	80H		;ready?
	JP	Z,TXRDY1	;yes, output
	PUSH	BC
	LD	C,POLL		;poll console 1 status out
	LD	E,PLCO1
	CALL	XDOS
	POP	BC
TXRDY1:	LD	A,C		;console 1 output
	OUT	(CON1DAT),A
	RET
;
LIST:
	LD	A,C
	OUT	(PRTDAT),A
	RET
;
;	not used by MP/M 2
PUNCH:
READER:
LISTST:
	RET
;
;	MP/M II V2.0 Xios
;
;	select/protect memory
;		BC = address of memory descriptor
SELMEMORY:
	LD	HL,3		;offset memory bank in memory descriptor
	ADD	HL,BC
	LD	A,(HL)		;get bank
	OUT	(MMUSEL),A	;and select it
	RET
;
;	poll character devices
;
POLLDEVICE:
	LD	A,C
	CP	NMBDEV		;device to poll in range?
	JP	C,DEVOK		;ok, poll it
	LD	A,NMBDEV	;no, set to max dev
DEVOK:	CALL	TBLJMP		;and jump to device poll code
DEVTBL:	DW	PTSTO0		;poll console 0 status out
	DW	PTSTI0		;poll console 0 status in
	DW	PTSTO1		;poll console 1 status out
	DW	PTSTI1		;poll console 1 status in
NMBDEV	EQU	($-DEVTBL)/2	;number of devices to poll
	DW	RTNEMPTY	;bad device handler
;
TBLJMP:				;compute and jump to handler, a = table index
	ADD	A,A		;double table index
	POP	HL		;get address of table
	LD	E,A		;compute table offeset
	LD	D,0
	ADD	HL,DE
	LD	E,(HL)		;get handler address
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	JP	(HL)		;jump to handler
;
RTNEMPTY:			;bad device, never ready
	XOR	A
	RET
;
;	start clock
;
STARTCLOCK:
	LD	A,0FFH
	LD	(TICKN),A
	RET
;
;	stop clock
;
STOPCLOCK:
	XOR	A
	LD	(TICKN),A
	RET
;
;	exit region:
;	enable interrupt if not preempted or in dispatcher
;
EXITREGION:
	LD	A,(PREEMP)
	OR	A
	RET	NZ
	EI
	RET
;
;	maximum console number
;
MAXCONSOLE:
	LD	A,NMBCNS
	RET
;
;	system initialization
;		C	MP/M debugger restart #
;		DE	MP/M entry point for debugger
;		HL	BIOS jump table address
;
SYSTEMINIT:
;
	IN	A,(MMUSEL)	;get number of memory banks
	RRA
	RRA
	RRA
	RRA
	AND	0FH
	INC	A
	LD	B,A
;
SYS1:	DEC	B
	LD	A,B
	OUT	(MMUSEL),A	;select every bank and initialize
	LD	A,0C3H		;jp instruction
	LD	(0),A
	LD	(38H),A
	PUSH	HL
	LD	L,C		;rst # > HL
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL		;rst address in HL
	LD	(HL),A		;debugger entry for configured rst
	INC	HL
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	HL
	LD	(1),HL
	PUSH	HL
	LD	HL,INTHND	;interrupt routine at rst 38
	LD	(39H),HL
	POP	HL
	JP	NZ,SYS1
;
;	bank 0 is selected now: the sign-on is in the banked part
	LD	HL,SIGNON	;print message
SYS2:	LD	A,(HL)
	OR	A
	JP	Z,SYS3
	OUT	(CON0DAT),A
	INC	HL
	JP	SYS2
;
SYS3:	LD	A,10H		;setup FDC command
	OUT	(FDC),A
	LD	HL,CMD
	LD	A,L
	OUT	(FDC),A
	LD	A,H
	OUT	(FDC),A
	IM	1
	LD	A,1		;enable 60 Hz interrupt timer
	OUT	(TIMER),A
	EI
	RET
;
;	idle
;
IDLE:	EI
	HALT
	RET
;
;	interrupt handler
;
INTHND:	LD	(SVDHL),HL	;save registers
	POP	HL
	LD	(SVDRET),HL
	PUSH	AF
	LD	HL,0
	ADD	HL,SP
	LD	(SVDSP),HL
	LD	SP,INTSTK
	PUSH	DE
	PUSH	BC
	LD	A,0FFH		;set preempted flag
	LD	(PREEMP),A
	LD	A,(TICKN)
	OR	A		;test tick, indicates delayed process
	JP	Z,INTHND1
	LD	C,FLAGSET	;set flag #1 each tick
	LD	E,1
	CALL	XDOS
INTHND1:
	LD	A,GETSEC	;get seconds from hardware clock
	OUT	(CLKCMD),A
	IN	A,(CLKDAT)
	OR	A		;full minute?
	JP	NZ,INTHND2
	LD	C,FLAGSET	;set flag #4 each full minute
	LD	E,4
	CALL	XDOS
INTHND2:
	LD	HL,CNTSEC	;decrement tick counter
	DEC	(HL)
	JP	NZ,INTDONE
	LD	(HL),TICKPS	;set flag #2 each second
	LD	C,FLAGSET
	LD	E,2
	CALL	XDOS
INTDONE:
	XOR	A		;clear preempted flag
	LD	(PREEMP),A
	POP	BC		;restore registers
	POP	DE
	LD	HL,(SVDSP)
	LD	SP,HL
	POP	AF
	LD	HL,(SVDRET)
	PUSH	HL
	LD	HL,(PDISP+1)	;dispatch processes
	PUSH	HL
	LD	HL,(SVDHL)
	RETI
;
;	the disk i/o, from READ and WRITE with the command in A: the
;	controller moves the data in the user's bank. Return a 00h in
;	register a if the operation completes properly, and 01h if an
;	error occurs during the read or write.
;
WAITIO:	LD	(IOCMD),A	;the banked part is out of sight now
	CALL	SWTUSER		;switch to user page
	LD	A,(IOCMD)
	OUT	(FDC),A		;ask FDC to execute the command
	CALL	SWTSYS		;switch back to system page
	IN	A,(FDC)		;get FDC status
	OR	A		;is it zero ?
	RET	Z		;return if OK
	CPL			;complement for LED's
	OUT	(LEDS),A	;display the error code
	LD	A,1		;nonrecoverable error
	RET			;return with error
;
;	XIOS data segment
;
TICKN:	DEFB	0		;flag for tick
PREEMP:	DEFB	0		;preempted flag
SVDHL:	DEFS	2		;save hl during interrupt
SVDRET:	DEFS	2		;save return address during interrupt
SVDSP:	DEFS	2		;save sp during interrupt
CNTSEC:	DEFB	TICKPS		;ticks per second counter
IOCMD:	DEFB	0		;the FDC command for WAITIO
;
				;interrupt stack
	DEFW	0C7C7H,0C7C7H,0C7C7H,0C7C7H
	DEFW	0C7C7H,0C7C7H,0C7C7H,0C7C7H
	DEFW	0C7C7H,0C7C7H,0C7C7H,0C7C7H
	DEFW	0C7C7H,0C7C7H,0C7C7H,0C7C7H
INTSTK:
;
;	disk parameter blocks, physical sectors of 128 bytes. Hard disks
;	have no directory checksums: another image is noticed through
;	port 8 (CHKFMT).
;
;	IBM 3740 8" SD disk
DPBFD:	DEFW	26		;sectors per track
	DEFB	3		;block shift factor
	DEFB	7		;block mask
	DEFB	0		;extent mask
	DEFW	242		;disk size-1
	DEFW	63		;directory max
	DEFB	192		;alloc 0
	DEFB	0		;alloc 1
	DEFW	16		;check size
	DEFW	2		;track offset
;
;	z80pack 4 MB hard disk: 255 tracks of 128 sectors, 2 KB blocks
DPBHD4:	DEFW	128		;sectors per track
	DEFB	4		;block shift factor
	DEFB	15		;block mask
	DEFB	0		;extent mask
	DEFW	2039		;disk size-1
	DEFW	1023		;directory max
	DEFB	255		;alloc 0
	DEFB	255		;alloc 1
	DEFW	0		;check size: none
	DEFW	0		;track offset
;
;	8 MB hard disk: 256 tracks of 255 sectors, 4 KB blocks
DPBHD8:	DEFW	255		;sectors per track
	DEFB	5		;block shift factor
	DEFB	31		;block mask
	DEFB	1		;extent mask
	DEFW	2039		;disk size-1
	DEFW	1023		;directory max
	DEFB	255		;alloc 0
	DEFB	0		;alloc 1
	DEFW	0		;check size: none
	DEFW	0		;track offset
;
DIRBF:	DEFS	128		;scratch directory area
;
;	FDC command bytes
;
CMD:	DEFS	4
DDTRK	EQU	CMD+0		;track
DDSEC	EQU	CMD+1		;sector
DDLDMA	EQU	CMD+2		;dma address low
DDHDMA	EQU	CMD+3		;dma address high
;
	END
