# The startup logo, generated by logo_gen.py from LOGO_IMAGE, for
# dvt_render (CMakeLists.txt here: GENERATED is the output directory). Sets
# LOGO_SOURCES.

find_package(Python3 REQUIRED COMPONENTS Interpreter)

set(LOGO_IMAGE "${CMAKE_CURRENT_LIST_DIR}/../../assets/logo/ColorLogo-576.png" CACHE FILEPATH
  "Startup logo: PNG, at most 800x576, width a multiple of 8, one hue")
set(LOGO_GEN "${CMAKE_CURRENT_LIST_DIR}/logo_gen.py")
set(LOGO_SOURCES "${GENERATED}/logo.c")

add_custom_command(
  OUTPUT ${LOGO_SOURCES}
  COMMAND ${CMAKE_COMMAND} -E make_directory ${GENERATED}
  COMMAND Python3::Interpreter ${LOGO_GEN} ${LOGO_IMAGE} ${LOGO_SOURCES}
  DEPENDS ${LOGO_GEN} ${LOGO_IMAGE}
  COMMENT "Generating the startup logo"
  VERBATIM)
